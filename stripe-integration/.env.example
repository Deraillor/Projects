# Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Prefer a restricted key (rk_test_... / rkcs_test_...) over a full secret key
STRIPE_SECRET_KEY=rk_test_replace_me

# From `stripe listen --forward-to localhost:4242/webhook`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# App
PORT=4242
DOMAIN=http://localhost:4242

# Marketplace platform fee in cents (destination charges)
PLATFORM_FEE_AMOUNT=200
